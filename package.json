{
  "name": "myhr",
  "private": true,
  "version": "0.1.0",
  "description": "MyHR - 人事管理系统（跨平台桌面/移动端）",
  "author": "MyHR",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "app:dev": "concurrently -k \"vite\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "app:start": "vite build && electron .",
    "app:build:win": "vite build && electron-builder --win",
    "app:build:mac": "vite build && electron-builder --mac",
    "app:build:mac-x64": "vite build && electron-builder --mac --x64",
    "app:build:mac-arm64": "vite build && electron-builder --mac --arm64",
    "mobile:sync": "vite build && cap sync",
    "mobile:android": "npm run mobile:sync && cap open android",
    "mobile:ios": "npm run mobile:sync && cap open ios"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@capacitor/android": "^6.2.0",
    "@capacitor/cli": "^6.2.0",
    "@capacitor/core": "^6.2.0",
    "@capacitor/ios": "^6.2.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^33.3.1",
    "electron-builder": "^25.1.8",
    "vite": "^5.4.11",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.myhr.desktop",
    "productName": "MyHR",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/**"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "mac": {
      "category": "public.app-category.business",
      "target": [
        "dmg"
      ]
    },
    "publish": null
  }
}
